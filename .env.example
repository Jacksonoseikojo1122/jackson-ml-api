# Copy to .env (never commit .env). All settings are optional.

# When set, every POST endpoint requires "Authorization: Bearer <token>". /health stays public.
ML_API_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of browser origins allowed by CORS. Omit or use * to allow any origin.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Set to 1 to load all models at startup instead of on first request.
PRELOAD_MODELS=0
